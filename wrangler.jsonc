{
  // Cloudflare Pages configuration. The quote-form email in
  // functions/api/quote.ts uses the Email Sending REST API; set the
  // CF_ACCOUNT_ID and EMAIL_API_TOKEN secrets in the Pages project
  // (Settings -> Variables and Secrets). Pages config does not support
  // the send_email binding (Workers-only).
  "name": "summitlighting",
  "compatibility_date": "2026-08-01",
  "pages_build_output_dir": "dist"
}
