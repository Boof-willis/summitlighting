---
// FAQ accordion component with original styling
---

<div class="max-w-[800px] mx-auto">
  <!-- FAQ Item 1 -->
  <div class="border-b border-gray-200">
    <button 
      class="faq-button py-8 w-full text-left cursor-pointer flex justify-between items-center gap-8 group"
      aria-expanded="false"
      aria-controls="faq-1"
    >
      <span class="text-[20px] font-heading font-normal text-gray-900 leading-relaxed">
        Do you provide the lights or do I need to buy them?
      </span>
      <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center transition-colors group-hover:bg-gray-200">
        <div class="relative w-4 h-4">
          <!-- Horizontal line - always visible -->
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-600 transform -translate-y-1/2"></div>
          <!-- Vertical line - rotates to horizontal when open -->
          <div class="faq-icon absolute top-0 left-1/2 w-0.5 h-full bg-gray-600 transform -translate-x-1/2 transition-transform duration-300"></div>
        </div>
      </div>
    </button>
    <div 
      id="faq-1" 
      class="faq-content overflow-hidden transition-all duration-500 ease-in-out max-h-0 opacity-0"
    >
      <div class="pb-8 text-gray-600 text-[14px] leading-[1.5] font-heading max-w-3xl">
        We provide everything! All commercial-grade LED lights, clips, extension cords, and timers are included in your quote. You don't need to buy anything.
      </div>
    </div>
  </div>

  <!-- FAQ Item 2 -->
  <div class="border-b border-gray-200">
    <button 
      class="faq-button py-8 w-full text-left cursor-pointer flex justify-between items-center gap-8 group"
      aria-expanded="false"
      aria-controls="faq-2"
    >
      <span class="text-[20px] font-heading font-normal text-gray-900 leading-relaxed">
        What's included in my quote?
      </span>
      <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center transition-colors group-hover:bg-gray-200">
        <div class="relative w-4 h-4">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-600 transform -translate-y-1/2"></div>
          <div class="faq-icon absolute top-0 left-1/2 w-0.5 h-full bg-gray-600 transform -translate-x-1/2 transition-transform duration-300"></div>
        </div>
      </div>
    </button>
    <div 
      id="faq-2" 
      class="faq-content overflow-hidden transition-all duration-500 ease-in-out max-h-0 opacity-0"
    >
      <div class="pb-8 text-gray-600 text-[14px] leading-[1.5] font-heading max-w-3xl">
        Everything! Your quote includes: all lights and equipment, custom design consultation, professional installation, season-long maintenance and repairs, takedown in January, and FREE year-round storage. We'll even return next year to reinstall!
      </div>
    </div>
  </div>

  <!-- FAQ Item 3 -->
  <div class="border-b border-gray-200">
    <button 
      class="faq-button py-8 w-full text-left cursor-pointer flex justify-between items-center gap-8 group"
      aria-expanded="false"
      aria-controls="faq-3"
    >
      <span class="text-[20px] font-heading font-normal text-gray-900 leading-relaxed">
        How long does installation take?
      </span>
      <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center transition-colors group-hover:bg-gray-200">
        <div class="relative w-4 h-4">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-600 transform -translate-y-1/2"></div>
          <div class="faq-icon absolute top-0 left-1/2 w-0.5 h-full bg-gray-600 transform -translate-x-1/2 transition-transform duration-300"></div>
        </div>
      </div>
    </button>
    <div 
      id="faq-3" 
      class="faq-content overflow-hidden transition-all duration-500 ease-in-out max-h-0 opacity-0"
    >
      <div class="pb-8 text-gray-600 text-[14px] leading-[1.5] font-heading max-w-3xl">
        Most homes are completed in 2-4 hours. Larger or more complex properties may take a full day. We work efficiently and clean up thoroughly, leaving no mess behind.
      </div>
    </div>
  </div>

  <!-- FAQ Item 4 -->
  <div class="border-b border-gray-200">
    <button 
      class="faq-button py-8 w-full text-left cursor-pointer flex justify-between items-center gap-8 group"
      aria-expanded="false"
      aria-controls="faq-4"
    >
      <span class="text-[20px] font-heading font-normal text-gray-900 leading-relaxed">
        What if a light goes out during the season?
      </span>
      <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center transition-colors group-hover:bg-gray-200">
        <div class="relative w-4 h-4">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-600 transform -translate-y-1/2"></div>
          <div class="faq-icon absolute top-0 left-1/2 w-0.5 h-full bg-gray-600 transform -translate-x-1/2 transition-transform duration-300"></div>
        </div>
      </div>
    </button>
    <div 
      id="faq-4" 
      class="faq-content overflow-hidden transition-all duration-500 ease-in-out max-h-0 opacity-0"
    >
      <div class="pb-8 text-gray-600 text-[14px] leading-[1.5] font-heading max-w-3xl">
        We'll fix it for free! Season-long maintenance is included in your quote. If any lights go out or get damaged, just give us a call and we'll come repair or replace them at no additional charge.
      </div>
    </div>
  </div>

  <!-- FAQ Item 5 -->
  <div class="border-b border-gray-200">
    <button 
      class="faq-button py-8 w-full text-left cursor-pointer flex justify-between items-center gap-8 group"
      aria-expanded="false"
      aria-controls="faq-5"
    >
      <span class="text-[20px] font-heading font-normal text-gray-900 leading-relaxed">
        When do you install and take down the lights?
      </span>
      <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center transition-colors group-hover:bg-gray-200">
        <div class="relative w-4 h-4">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-600 transform -translate-y-1/2"></div>
          <div class="faq-icon absolute top-0 left-1/2 w-0.5 h-full bg-gray-600 transform -translate-x-1/2 transition-transform duration-300"></div>
        </div>
      </div>
    </button>
    <div 
      id="faq-5" 
      class="faq-content overflow-hidden transition-all duration-500 ease-in-out max-h-0 opacity-0"
    >
      <div class="pb-8 text-gray-600 text-[14px] leading-[1.5] font-heading max-w-3xl">
        We begin installing in early October and continue through early December, so your home is holiday-ready well before Thanksgiving. Takedown happens in January. You pick your preferred dates, and we recommend booking in September or early October for the best scheduling options. We store your lights year-round for free and return next season to reinstall them.
      </div>
    </div>
  </div>

</div>

<script is:inline>
  // FAQ Accordion functionality with original styling
  document.addEventListener('DOMContentLoaded', function() {
    const faqButtons = document.querySelectorAll('.faq-button');
    
    faqButtons.forEach(button => {
      button.addEventListener('click', function() {
        const controlsId = this.getAttribute('aria-controls');
        if (!controlsId) return;
        
        const content = document.getElementById(controlsId);
        if (!content) return;
        
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const icon = this.querySelector('.faq-icon');
        
        // Close all other FAQs
        faqButtons.forEach(otherButton => {
          if (otherButton !== this) {
            const otherControlsId = otherButton.getAttribute('aria-controls');
            if (!otherControlsId) return;
            
            const otherContent = document.getElementById(otherControlsId);
            const otherIcon = otherButton.querySelector('.faq-icon');
            otherButton.setAttribute('aria-expanded', 'false');
            
            if (otherContent) {
              otherContent.classList.remove('max-h-96', 'opacity-100');
              otherContent.classList.add('max-h-0', 'opacity-0');
            }
            if (otherIcon) {
              otherIcon.classList.remove('rotate-90');
            }
          }
        });
        
        // Toggle current FAQ
        if (isExpanded) {
          this.setAttribute('aria-expanded', 'false');
          content.classList.remove('max-h-96', 'opacity-100');
          content.classList.add('max-h-0', 'opacity-0');
          if (icon) icon.classList.remove('rotate-90');
        } else {
          this.setAttribute('aria-expanded', 'true');
          content.classList.remove('max-h-0', 'opacity-0');
          content.classList.add('max-h-96', 'opacity-100');
          if (icon) icon.classList.add('rotate-90');
        }
      });
      
      // Keyboard navigation
      button.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.click();
        }
      });
    });
  });
</script>