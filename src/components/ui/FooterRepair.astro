---
// Footer component for Summit Lighting Co.
---

<footer class="bg-black text-white py-16">
  <div class="max-w-[1200px] mx-auto px-8">
    <div class="flex flex-col md:flex-row justify-between gap-16">
      <!-- Brand/About Column - Left Side -->
      <div class="md:max-w-[350px]">
        <div class="flex items-center gap-3 mb-6">
          <img 
            src="https://static.wixstatic.com/media/9ce439_a1db304484b242b1b0e22b76abb1ff80~mv2.png/v1/fill/w_538,h_186,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Summit-Logo-White-4x.png"
            alt="Summit Lighting Co."
            class="h-12 w-auto"
          />
        </div>
        <p class="text-gray-400 leading-relaxed mb-6 font-heading">
          Professional Christmas light installation in Utah County. We provide all lights, professional installation, maintenance, and FREE year-round storage.
        </p>
        <p class="text-gray-500 text-sm font-heading">
          Locally-Owned & Operated • Serving Utah County
        </p>
      </div>

      <!-- Links Group - Right Side -->
      <div class="flex flex-col sm:flex-row gap-12 md:gap-16">
        <!-- Quick Links Column -->
        <div>
          <h4 class="text-base font-medium mb-6 text-gray-300 font-heading">Quick Links</h4>
          <ul class="space-y-3">
            <li>
              <a href="#programs" class="text-gray-400 hover:text-white transition-colors font-heading">How It Works</a>
            </li>
            <li>
              <a href="#why-us" class="text-gray-400 hover:text-white transition-colors font-heading">Why Us</a>
            </li>
            <li>
              <a href="#value-proposition" class="text-gray-400 hover:text-white transition-colors font-heading">Get Quote</a>
            </li>
            <li>
              <a href="#faq" class="text-gray-400 hover:text-white transition-colors font-heading">FAQs</a>
            </li>
          </ul>
        </div>

        <!-- Contact Column -->
        <div>
          <h4 class="text-base font-medium mb-6 text-gray-300 font-heading">Contact</h4>
          <ul class="space-y-3">
            <li>
              <a href="tel:+18011234567" class="text-gray-400 hover:text-white transition-colors font-heading" onclick="window.dispatchEvent(new Event('PhoneCallClick'))">
                (801) 123-4567
              </a>
            </li>
            <li>
              <a href="mailto:info@summitlightingco.com" class="text-gray-400 hover:text-white transition-colors font-heading">
                info@summitlightingco.com
              </a>
            </li>
            <li>
              <a href="#value-proposition" class="text-gray-400 hover:text-white transition-colors font-heading">
                Request Free Quote
              </a>
            </li>
            <li class="text-gray-500 text-sm pt-2 font-heading">
              Mon-Fri: 9am-6pm<br />
              Sat: 10am-4pm<br />
              Installation Season: Sept-Jan
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
