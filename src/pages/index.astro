    <!-- FAQPage schema (AI-citation benefit; no Google rich result for commercial sites) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you provide the lights or do I need to buy them?",
          "acceptedAnswer": { "@type": "Answer", "text": "We provide everything! All commercial-grade LED lights, clips, extension cords, and timers are included in your quote. You don't need to buy anything." }
        },
        {
          "@type": "Question",
          "name": "What's included in my quote?",
          "acceptedAnswer": { "@type": "Answer", "text": "Everything! Your quote includes: all lights and equipment, custom design consultation, professional installation, season-long maintenance and repairs, takedown in January, and FREE year-round storage. We'll even return next year to reinstall!" }
        },
        {
          "@type": "Question",
          "name": "How long does installation take?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most homes are completed in 2-4 hours. Larger or more complex properties may take a full day. We work efficiently and clean up thoroughly, leaving no mess behind." }
        },
        {
          "@type": "Question",
          "name": "What if a light goes out during the season?",
          "acceptedAnswer": { "@type": "Answer", "text": "We'll fix it for free! Season-long maintenance is included in your quote. If any lights go out or get damaged, just give us a call and we'll come repair or replace them at no additional charge." }
        },
        {
          "@type": "Question",
          "name": "When do you install and take down the lights?",
          "acceptedAnswer": { "@type": "Answer", "text": "We begin installing in early October and continue through early December, so your home is holiday-ready well before Thanksgiving. Takedown happens in January. You pick your preferred dates, and we recommend booking in September or early October for the best scheduling options. We store your lights year-round for free and return next season to reinstall them." }
        }
      ]
    }
    </script>

