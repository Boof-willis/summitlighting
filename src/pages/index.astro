    <!-- Analytics and Event Tracking Script -->
    <script>
      // Parse URL parameters for tracking
      function getUrlParams() {
        const params = new URLSearchParams(window.location.search);
        return {
          gclid: params.get('gclid'),
          gbraid: params.get('gbraid'),
          wbraid: params.get('wbraid'),
          utm_source: params.get('utm_source'),
          utm_medium: params.get('utm_medium'),
          utm_campaign: params.get('utm_campaign'),
          utm_term: params.get('utm_term'),
          utm_content: params.get('utm_content')
        };
      }

      // Populate hidden form fields
      function populateTrackingFields() {
        const params = getUrlParams();
        const form = document.getElementById('repair-form');
        if (form) {
          Object.entries(params).forEach(([key, value]) => {
            const input = form.querySelector(`input[name="${key}"]`) as HTMLInputElement | null;
            if (input && value) {
              input.value = value;
            }
          });
          
          // Set landing page and referrer
          const landingPageInput = form.querySelector('input[name="landing_page"]') as HTMLInputElement | null;
          const referrerInput = form.querySelector('input[name="referrer"]') as HTMLInputElement | null;
          if (landingPageInput) landingPageInput.value = window.location.href;
          if (referrerInput) referrerInput.value = document.referrer;
        }
      }

      // Track scroll depth
      let scrollDepth50Fired = false;
      function trackScrollDepth() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;
        
        if (scrollPercent >= 50 && !scrollDepth50Fired) {
          scrollDepth50Fired = true;
          window.dispatchEvent(new Event('ScrollDepth50'));
        }
      }

      // Track phone call clicks
      function trackPhoneCalls() {
        const phoneLinks = document.querySelectorAll('a[href^="tel:"]');
        phoneLinks.forEach(link => {
          link.addEventListener('click', () => {
            window.dispatchEvent(new Event('PhoneCallClick'));
          });
        });
      }

      // Track form submissions
      function trackFormSubmissions() {
        const form = document.getElementById('repair-form');
        if (form) {
          form.addEventListener('submit', () => {
            // Let the form submit normally, then track
            setTimeout(() => {
              window.dispatchEvent(new Event('Lead'));
            }, 100);
          });
        }
      }

      // Initialize tracking when DOM is loaded
      document.addEventListener('DOMContentLoaded', () => {
        populateTrackingFields();
        trackPhoneCalls();
        trackFormSubmissions();
        window.addEventListener('scroll', trackScrollDepth);
      });

      // GA4 Placeholder - Replace with actual GA4 code
      // gtag('config', 'GA_MEASUREMENT_ID');
    </script>

    <!-- GoHighLevel Dynamic Number Tracking - Custom implementation for React/Astro -->
    <script is:inline>
      // Configuration
      const STATIC_NUMBER = '(385) 539-8892';
      const STATIC_NUMBER_TEL = '+13855398892';
      const GHL_LOCATION_ID = 'XWsWcayA7pICQzloojOk';
      const GHL_POOL_ID = '6VAwP2SGOq94U72i6OvU';
      
      // Function to get tracking number from GHL
      async function getTrackingNumber() {
        try {
          const response = await fetch(`https://backend.leadconnectorhq.com/appengine/loc/${GHL_LOCATION_ID}/pool/${GHL_POOL_ID}/number_pool.js`);
          if (!response.ok) throw new Error('Failed to load tracking number');
          
          // The script sets a global variable, let's wait for it
          return new Promise((resolve) => {
            const checkInterval = setInterval(() => {
              if (window.phoneNumber || window.trackingNumber || window.ghl_phone) {
                clearInterval(checkInterval);
                resolve(window.phoneNumber || window.trackingNumber || window.ghl_phone);
              }
            }, 100);
            
            // Timeout after 3 seconds
            setTimeout(() => {
              clearInterval(checkInterval);
              resolve(null);
            }, 3000);
          });
        } catch (error) {
          console.log('Using static number:', error instanceof Error ? error.message : 'Unknown error');
          return null;
        }
      }
      
      // Function to swap phone numbers
      function swapPhoneNumbers(trackingNumber) {
        if (!trackingNumber) return;
        
        console.log('Swapping numbers from', STATIC_NUMBER, 'to', trackingNumber);
        
        // Format the tracking number for display
        const formattedTracking = trackingNumber;
        
        // Find and replace all text nodes containing the phone number
        const walker = document.createTreeWalker(
          document.body,
          NodeFilter.SHOW_TEXT,
          null
        );
        
        const nodesToReplace = [];
        let node;
        while ((node = walker.nextNode())) {
          if (node.textContent && node.textContent.includes(STATIC_NUMBER)) {
            nodesToReplace.push(node);
          }
        }
        
        nodesToReplace.forEach(node => {
          if (node.textContent) {
            node.textContent = node.textContent.replace(new RegExp(STATIC_NUMBER, 'g'), formattedTracking);
          }
        });
        
        // Replace all tel: links
        const telLinks = document.querySelectorAll('a[href*="tel:"]');
        telLinks.forEach(link => {
          const currentHref = link.getAttribute('href');
          if (currentHref && (currentHref.includes(STATIC_NUMBER_TEL) || currentHref.includes(STATIC_NUMBER.replace(/[^0-9]/g, '')))) {
            // Extract just the tracking number digits
            const trackingDigits = formattedTracking.replace(/[^0-9]/g, '');
            link.setAttribute('href', `tel:+1${trackingDigits}`);
          }
        });
      }
      
      // Initialize tracking on page load
      async function initializeTracking() {
        // Wait for React components to hydrate
        await new Promise(resolve => setTimeout(resolve, 1000));
        
        // Load the GHL scripts
        const script1 = document.createElement('script');
        script1.src = `https://backend.leadconnectorhq.com/appengine/loc/${GHL_LOCATION_ID}/pool/${GHL_POOL_ID}/number_pool.js`;
        script1.async = true;
        document.body.appendChild(script1);
        
        const script2 = document.createElement('script');
        script2.src = 'https://backend.leadconnectorhq.com/appengine/js/user_session.js';
        script2.async = true;
        document.body.appendChild(script2);
        
        // Wait for tracking number
        const trackingNumber = await getTrackingNumber();
        
        if (trackingNumber) {
          // Initial swap
          swapPhoneNumbers(trackingNumber);
          
          // Watch for dynamic content changes (React re-renders)
          const observer = new MutationObserver(() => {
            swapPhoneNumbers(trackingNumber);
          });
          
          observer.observe(document.body, {
            childList: true,
            subtree: true,
            characterData: true
          });
        }
      }
      
      // Start when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeTracking);
      } else {
        initializeTracking();
      }
    </script>
  </body>
</html>
