      <!-- Services Section Scroll Animation Script -->
      <script is:inline>
        // Scroll-based scale animation for sticky cards
        function initStickyCardAnimation(cardElement) {
          let ticking = false;

          const updateCardScale = () => {
            if (!cardElement) return;

            const rect = cardElement.getBoundingClientRect();
            const cardTop = rect.top;
            const cardHeight = rect.height;
            const viewportHeight = window.innerHeight;

            const entryPoint = viewportHeight;
            const exitPoint = entryPoint - cardHeight;

            let scale = 0.9;

            if (cardTop <= entryPoint && cardTop >= exitPoint) {
              const progress = (entryPoint - cardTop) / (entryPoint - exitPoint);
              scale = 0.9 + 0.1 * Math.max(0, Math.min(1, progress));
            } else if (cardTop < exitPoint) {
              scale = 1.0;
            }

            cardElement.style.transform = `translateY(0) scale(${scale})`;
            ticking = false;
          };

          const requestTick = () => {
            if (!ticking) {
              requestAnimationFrame(updateCardScale);
              ticking = true;
            }
          };

          window.addEventListener('scroll', requestTick, { passive: true });
          updateCardScale();

          return () => window.removeEventListener('scroll', requestTick);
        }

        // Initialize animations for all service cards with Intersection Observer for smooth entrance
        document.addEventListener('DOMContentLoaded', () => {
          const cards = document.querySelectorAll('.service-card');
          
          // Create a map to track card indices
          const cardIndices = new Map();
          cards.forEach((card, index) => {
            cardIndices.set(card, index);
          });
          
          // Create Intersection Observer to trigger animations early (200px before viewport)
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const card = entry.target;
                const index = cardIndices.get(card) || 0;
                // Add animation class with staggered delay
                if (card.style) {
                  card.style.animationDelay = `${index * 0.08}s`;
                  card.classList.add('card-animate');
                }
                // Stop observing once animated
                observer.unobserve(card);
              }
            });
          }, {
            rootMargin: '200px 0px', // Start animation 200px before card enters viewport
            threshold: 0
          });

          cards.forEach((card) => {
            const htmlCard = card;
            if (htmlCard) {
              // Observe each card
              observer.observe(htmlCard);
              // Initialize sticky scroll animation
              initStickyCardAnimation(htmlCard);
            }
          });
        });
      </script>

