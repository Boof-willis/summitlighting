          <div class="glow-orb absolute -top-32 left-[15%] w-[500px] h-[500px] rounded-full" data-speed="0.06" style="background: radial-gradient(circle, rgba(255, 90, 90, 0.16), transparent 65%); will-change: transform;"></div>
          <div class="glow-orb absolute top-[22%] -right-40 w-[600px] h-[600px] rounded-full" data-speed="0.12" style="background: radial-gradient(circle, rgba(90, 150, 255, 0.14), transparent 65%); will-change: transform;"></div>
          <div class="glow-orb absolute top-[52%] -left-40 w-[550px] h-[550px] rounded-full" data-speed="0.08" style="background: radial-gradient(circle, rgba(90, 230, 140, 0.13), transparent 65%); will-change: transform;"></div>
          <div class="glow-orb absolute bottom-[2%] right-[10%] w-[500px] h-[500px] rounded-full" data-speed="0.15" style="background: radial-gradient(circle, rgba(255, 196, 110, 0.12), transparent 65%); will-change: transform;"></div>
        </div>

        <script>
          // Delayed parallax drift for the glow orbs: each orb trails the scroll
          // at its own speed for a depth effect. Skipped for reduced-motion users.
          (() => {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const section = document.getElementById('services');
            const orbs = Array.from(document.querySelectorAll('.glow-orb')) as HTMLElement[];
            if (!section || orbs.length === 0) return;
            let ticking = false;
            const update = () => {
              const offset = window.scrollY - section.offsetTop;
              orbs.forEach((orb) => {
                const speed = parseFloat(orb.dataset.speed || '0.1');
                orb.style.transform = `translate3d(0, ${offset * speed}px, 0)`;
              });
              ticking = false;
            };
            window.addEventListener('scroll', () => {
              if (!ticking) {
                ticking = true;
                window.requestAnimationFrame(update);
              }
            }, { passive: true });
            update();
          })();
        </script>

